#!/usr/bin/env sh
set -eu

hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
checker="$hook_dir/../.agents/skills/sub2api-production-deploy/scripts/check_local_deployment_disclosure.py"
if ssh_config=$(git config --path sub2api.sshConfig 2>/dev/null); then
  SUB2API_SSH_CONFIG="$ssh_config" python "$checker" --pre-push
else
  python "$checker" --pre-push
fi

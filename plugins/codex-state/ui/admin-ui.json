                  ]
                }
              ]
            },
            {
              "type": "data_table",
              "id": "logs-table",
              "title": "Run logs",
              "title_key": "run_logs",
              "description": "Only allowlisted, redacted diagnostic codes are shown; STATE, tokens, proxy credentials and raw errors are never displayed.",
              "description_key": "logs_description",
              "bind": "/status/logs",
              "row_key": "id",
              "page_size": 25,
              "sort_key": "at",
              "sort_desc": true,
              "filters": [
                { "bind": "/local/log_level", "key": "level" },
                { "bind": "/local/log_account", "key": "account_id" },
                { "bind": "/local/log_model", "key": "model" }
              ],
              "columns": [
                { "key": "at", "label": "Time", "label_key": "time", "bind": "/item/at", "format": "date" },
                { "key": "account_id", "label": "Account", "label_key": "account", "bind": "/item/account_id" },
                { "key": "model", "label": "Model", "label_key": "model", "bind": "/item/model" },
                { "key": "level", "label": "Level", "label_key": "level", "bind": "/item/level" },
                { "key": "code", "label": "Diagnostic code", "label_key": "diagnostic_code", "bind": "/item/code" }
              ]
            }

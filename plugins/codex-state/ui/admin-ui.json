            {
              "type": "grid",
              "id": "log-filters",
              "children": [
                {
                  "type": "select",
                  "id": "log-level-filter",
                  "title": "Level",
                  "title_key": "level",
                  "write": "/local/log_level",
                  "options": [
                    { "value": "__all__", "label": "All levels", "label_key": "all_levels" },
                    { "value": "info", "label": "Info", "label_key": "info" },
                    { "value": "error", "label": "Error", "label_key": "error" }
                  ]
                },
                {
                  "type": "select",
                  "id": "log-account-filter",
                  "title": "Account",
                  "title_key": "account",
                  "write": "/local/log_account",
                  "options": [ { "value": "__all__", "label": "All accounts", "label_key": "all_accounts" } ],
                  "options_bind": "/resources/accounts"
                },
                {
                  "type": "select",
                  "id": "log-model-filter",
                  "title": "Model",
                  "title_key": "model",
                  "write": "/local/log_model",
                  "options": [
                    { "value": "__all__", "label": "All models", "label_key": "all_models" },
                    { "value": "gpt-6-astra", "label": "Astra", "label_key": "astra" },

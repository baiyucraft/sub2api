  "layout": [
    {
      "type": "section",
      "id": "global",
      "title": "Runtime",
      "title_key": "runtime",
      "description": "Managed account models remain fail-closed while the plugin is unavailable.",
      "description_key": "runtime_description",
      "children": [
        {
          "type": "grid",
          "id": "global-fields",
          "children": [
            {
              "type": "switch",
              "id": "enabled",
              "title": "Enable Codex STATE",
              "title_key": "enabled",
              "bind": "/config/enabled",
              "write": "/config/enabled"
            },
            {
              "type": "badge",
              "id": "running",
              "title": "Runtime status",
              "title_key": "runtime_status",
              "bind": "/status/running"
            }
          ]
        },
        {
          "type": "action_group",
          "id": "global-actions",
          "children": [
            {
              "type": "button",
              "id": "save",
              "title": "Save",
              "title_key": "save",
              "icon": "check",
              "action": "config.save"
            },
            {
              "type": "button",
              "id": "refresh",
              "title": "Refresh",
              "title_key": "refresh",
              "icon": "refresh",
              "action": "config.refresh"
            },
            {
              "type": "button",
              "id": "secrets",
              "title": "Edit proxy credentials",
              "title_key": "edit_proxy_credentials",
              "icon": "key",
              "action": "plugin.secrets.edit"
            }
          ]
        }
      ]
    },
    {
      "type": "tabs",
      "id": "content-tabs",
      "children": [
        {
          "type": "section",
          "id": "overview",
          "title": "Overview",
          "title_key": "overview",
          "icon": "chartBar",
          "children": [
            {
              "type": "grid",
              "id": "overview-stats",
              "children": [
                { "type": "stat", "id": "account-count", "title": "Configured accounts", "title_key": "configured_accounts", "bind": "/status/summary/configured_accounts", "format": "count" },
                { "type": "stat", "id": "no-egress-count", "title": "No business egress", "title_key": "no_business_egress", "bind": "/status/summary/no_egress_accounts", "format": "count" },
                { "type": "stat", "id": "strike-count", "title": "Active strikes", "title_key": "active_strikes", "bind": "/status/summary/strike_count", "format": "count" }
              ]
            },
            {
              "type": "table",
              "id": "model-summary",
              "title": "Model readiness",
              "title_key": "model_readiness",
              "bind": "/status/accounts",
              "columns": [
                { "key": "account_id", "label": "Account", "label_key": "account", "bind": "/item/account_id" },
                { "key": "astra", "label": "Astra", "label_key": "astra", "bind": "/item/models/gpt-6-astra/state" },
                { "key": "sol", "label": "Sol", "label_key": "sol", "bind": "/item/models/gpt-5.6-sol/state" },
                { "key": "terra", "label": "Terra", "label_key": "terra", "bind": "/item/models/gpt-5.6-terra/state" }
              ]
            }
          ]
        },
        {
          "type": "section",
          "id": "accounts",
          "title": "Accounts",
          "title_key": "accounts",
          "icon": "users",
          "children": [
            {
              "type": "search",
              "id": "account-search",
              "title": "Search account name or ID",
              "title_key": "search_account",
              "write": "/local/account_query"
            },
            {
              "type": "select",
              "id": "account-group-filter",
              "title": "Filter by group",
              "title_key": "filter_group",
              "write": "/local/account_group",
              "options": [ { "value": "__all__", "label": "All groups", "label_key": "all_groups" } ],
              "options_bind": "/resources/groups"
            },
            {
              "type": "checkbox",
              "id": "configured-only",
              "title": "Only show configured accounts",
              "title_key": "configured_only",
              "write": "/local/configured_only"
            },
            {
              "type": "data_table",
              "id": "account-table",
              "title": "Managed accounts",
              "title_key": "managed_accounts",
              "bind": "/status/accounts",
              "row_key": "account_id",
              "page_size": 20,
              "search_bind": "/local/account_query",
              "filter_bind": "/local/account_group",
              "filter_key": "group_ids",
              "filter_options_bind": "/resources/groups",
              "presence_filter_bind": "/local/configured_only",
              "presence_key": "configured",
              "selection_bind": "/local/selected_account_ids",
              "columns": [
                { "key": "account_id", "label": "ID", "label_key": "id", "bind": "/item/account_id" },
                { "key": "name", "label": "Name", "label_key": "name", "bind": "/item/name" },
                { "key": "account_type", "label": "Type", "label_key": "type", "bind": "/item/account_type" },
                { "key": "configured", "label": "Configured", "label_key": "configured", "bind": "/item/configured", "format": "boolean" },
                { "key": "available", "label": "Available", "label_key": "available", "bind": "/item/available", "format": "boolean" },
                { "key": "business_egress_configured", "label": "Egress", "label_key": "egress", "bind": "/item/business_egress_configured", "format": "boolean" },
                { "key": "astra", "label": "Astra", "label_key": "astra", "bind": "/item/models/gpt-6-astra/state" },
                { "key": "sol", "label": "Sol", "label_key": "sol", "bind": "/item/models/gpt-5.6-sol/state" },
                { "key": "terra", "label": "Terra", "label_key": "terra", "bind": "/item/models/gpt-5.6-terra/state" }
              ],
              "children": [
                {
                  "type": "section",
                  "id": "astra-details",
                  "title": "Astra",
                  "title_key": "astra",
                  "children": [
                    { "type": "grid", "id": "astra-detail-grid", "children": [
                      { "type": "stat", "id": "astra-state", "title": "State", "title_key": "state", "bind": "/item/models/gpt-6-astra/state" },
                      { "type": "stat", "id": "astra-plan", "title": "Ticket plan", "title_key": "ticket_plan", "bind": "/item/models/gpt-6-astra/ticket_plan" },
                      { "type": "stat", "id": "astra-active", "title": "Active", "title_key": "active", "bind": "/item/models/gpt-6-astra/active/remaining_seconds", "format": "duration" },
                      { "type": "stat", "id": "astra-ready", "title": "Ready", "title_key": "ready", "bind": "/item/models/gpt-6-astra/ready/remaining_seconds", "format": "duration" },
                      { "type": "stat", "id": "astra-strikes", "title": "Strikes", "title_key": "strikes", "bind": "/item/models/gpt-6-astra/strikes", "format": "count" },
                      { "type": "stat", "id": "astra-attempts", "title": "Attempts", "title_key": "attempts", "bind": "/item/models/gpt-6-astra/attempts", "format": "count" },
                      { "type": "stat", "id": "astra-refreshing", "title": "Refreshing", "title_key": "refreshing", "bind": "/item/models/gpt-6-astra/refreshing", "format": "boolean" },
                      { "type": "stat", "id": "astra-cooldown", "title": "Cooldown until", "title_key": "cooldown_until", "bind": "/item/models/gpt-6-astra/cooldown_until", "format": "date" },
                      { "type": "stat", "id": "astra-error", "title": "Last diagnostic", "title_key": "last_error", "bind": "/item/models/gpt-6-astra/last_error" }
                    ] }
                  ]
                },
                {
                  "type": "section",
                  "id": "sol-details",
                  "title": "Sol",
                  "title_key": "sol",
                  "children": [
                    { "type": "grid", "id": "sol-detail-grid", "children": [
                      { "type": "stat", "id": "sol-state", "title": "State", "title_key": "state", "bind": "/item/models/gpt-5.6-sol/state" },
                      { "type": "stat", "id": "sol-plan", "title": "Ticket plan", "title_key": "ticket_plan", "bind": "/item/models/gpt-5.6-sol/ticket_plan" },
                      { "type": "stat", "id": "sol-active", "title": "Active", "title_key": "active", "bind": "/item/models/gpt-5.6-sol/active/remaining_seconds", "format": "duration" },
                      { "type": "stat", "id": "sol-ready", "title": "Ready", "title_key": "ready", "bind": "/item/models/gpt-5.6-sol/ready/remaining_seconds", "format": "duration" },
                      { "type": "stat", "id": "sol-strikes", "title": "Strikes", "title_key": "strikes", "bind": "/item/models/gpt-5.6-sol/strikes", "format": "count" },
                      { "type": "stat", "id": "sol-attempts", "title": "Attempts", "title_key": "attempts", "bind": "/item/models/gpt-5.6-sol/attempts", "format": "count" },
                      { "type": "stat", "id": "sol-refreshing", "title": "Refreshing", "title_key": "refreshing", "bind": "/item/models/gpt-5.6-sol/refreshing", "format": "boolean" },
                      { "type": "stat", "id": "sol-cooldown", "title": "Cooldown until", "title_key": "cooldown_until", "bind": "/item/models/gpt-5.6-sol/cooldown_until", "format": "date" },
                      { "type": "stat", "id": "sol-error", "title": "Last diagnostic", "title_key": "last_error", "bind": "/item/models/gpt-5.6-sol/last_error" }
                    ] }
                  ]
                },
                {
                  "type": "section",
                  "id": "terra-details",
                  "title": "Terra",
                  "title_key": "terra",
                  "children": [
                    { "type": "grid", "id": "terra-detail-grid", "children": [
                      { "type": "stat", "id": "terra-state", "title": "State", "title_key": "state", "bind": "/item/models/gpt-5.6-terra/state" },
                      { "type": "stat", "id": "terra-plan", "title": "Ticket plan", "title_key": "ticket_plan", "bind": "/item/models/gpt-5.6-terra/ticket_plan" },
                      { "type": "stat", "id": "terra-active", "title": "Active", "title_key": "active", "bind": "/item/models/gpt-5.6-terra/active/remaining_seconds", "format": "duration" },
                      { "type": "stat", "id": "terra-ready", "title": "Ready", "title_key": "ready", "bind": "/item/models/gpt-5.6-terra/ready/remaining_seconds", "format": "duration" },
                      { "type": "stat", "id": "terra-strikes", "title": "Strikes", "title_key": "strikes", "bind": "/item/models/gpt-5.6-terra/strikes", "format": "count" },
                      { "type": "stat", "id": "terra-attempts", "title": "Attempts", "title_key": "attempts", "bind": "/item/models/gpt-5.6-terra/attempts", "format": "count" },
                      { "type": "stat", "id": "terra-refreshing", "title": "Refreshing", "title_key": "refreshing", "bind": "/item/models/gpt-5.6-terra/refreshing", "format": "boolean" },
                      { "type": "stat", "id": "terra-cooldown", "title": "Cooldown until", "title_key": "cooldown_until", "bind": "/item/models/gpt-5.6-terra/cooldown_until", "format": "date" },
                      { "type": "stat", "id": "terra-error", "title": "Last diagnostic", "title_key": "last_error", "bind": "/item/models/gpt-5.6-terra/last_error" }
                    ] }
                  ]
                }
              ],
              "row_actions": [
                {
                  "type": "button",
                  "id": "harvest-row",
                  "title": "Harvest Astra",
                  "title_key": "harvest_astra",
                  "icon": "play",
                  "action": "harvest",
                  "values": { "model": "gpt-6-astra" },
                  "payload": { "account_id": "/item/account_id" },
                  "condition": { "op": "truthy", "path": "/item/models/gpt-6-astra/enabled" }
                },
                {
                  "type": "button",
                  "id": "cancel-row",
                  "title": "Cancel Astra",
                  "title_key": "cancel_astra",
                  "description": "Cancel the Astra harvest for this account?",
                  "description_key": "cancel_confirm",
                  "icon": "x",
                  "action": "cancel",
                  "values": { "model": "gpt-6-astra" },
                  "payload": { "account_id": "/item/account_id" },
                  "condition": { "op": "truthy", "path": "/item/models/gpt-6-astra/enabled" },
                  "confirm": true
                },
                {
                  "type": "button",
                  "id": "harvest-sol-row",
                  "title": "Harvest Sol",
                  "title_key": "harvest_sol",
                  "icon": "play",
                  "action": "harvest",
                  "values": { "model": "gpt-5.6-sol" },
                  "payload": { "account_id": "/item/account_id" },
                  "condition": { "op": "truthy", "path": "/item/models/gpt-5.6-sol/enabled" }
                },
                {
                  "type": "button",
                  "id": "cancel-sol-row",
                  "title": "Cancel Sol",
                  "title_key": "cancel_sol",
                  "description": "Cancel the Sol harvest for this account?",
                  "description_key": "cancel_confirm",
                  "icon": "x",
                  "action": "cancel",
                  "values": { "model": "gpt-5.6-sol" },
                  "payload": { "account_id": "/item/account_id" },
                  "condition": { "op": "truthy", "path": "/item/models/gpt-5.6-sol/enabled" },
                  "confirm": true
                },
                {
                  "type": "button",
                  "id": "harvest-terra-row",
                  "title": "Harvest Terra",
                  "title_key": "harvest_terra",
                  "icon": "play",
                  "action": "harvest",
                  "values": { "model": "gpt-5.6-terra" },
                  "payload": { "account_id": "/item/account_id" },
                  "condition": { "op": "truthy", "path": "/item/models/gpt-5.6-terra/enabled" }
                },
                {
                  "type": "button",
                  "id": "cancel-terra-row",
                  "title": "Cancel Terra",
                  "title_key": "cancel_terra",
                  "description": "Cancel the Terra harvest for this account?",
                  "description_key": "cancel_confirm",
                  "icon": "x",
                  "action": "cancel",
                  "values": { "model": "gpt-5.6-terra" },
                  "payload": { "account_id": "/item/account_id" },
                  "condition": { "op": "truthy", "path": "/item/models/gpt-5.6-terra/enabled" },
                  "confirm": true
                }
              ]
            },
            {
              "type": "section",
              "id": "bulk-editor",
              "title": "Bulk model settings",
              "title_key": "bulk_settings",
              "description": "Each button changes only the named field for the selected accounts. Other model settings remain unchanged.",
              "description_key": "bulk_settings_description",
              "children": [
                {
                  "type": "grid",
                  "id": "bulk-astra",
                  "title": "Astra",
                  "title_key": "astra",
                  "children": [
                    {
                      "type": "button",
                      "id": "bulk-astra-enable",
                      "title": "Enable",
                      "title_key": "enable",
                      "icon": "check",
                      "action": "accounts.bulk_update",
                      "payload": { "account_ids": "/local/selected_account_ids" },
                      "values": { "models": { "gpt-6-astra": { "enabled": true } } },
                      "condition": { "op": "nonempty", "path": "/local/selected_account_ids" },
                      "apply_result": "config",
                      "confirm": true,
                      "description": "Apply this explicit change to the selected accounts?",
                      "description_key": "bulk_confirm"
                    },
                    {
                      "type": "button",
                      "id": "bulk-astra-disable",
                      "title": "Disable",
                      "title_key": "disable",
                      "icon": "x",
                      "action": "accounts.bulk_update",
                      "payload": { "account_ids": "/local/selected_account_ids" },
                      "values": { "models": { "gpt-6-astra": { "enabled": false } } },
                      "condition": { "op": "nonempty", "path": "/local/selected_account_ids" },
                      "apply_result": "config",
                      "confirm": true,
                      "description": "Apply this explicit change to the selected accounts?",
                      "description_key": "bulk_confirm"
                    },
                    {
                      "type": "button",
                      "id": "bulk-astra-pro",
                      "title": "Set Pro",
                      "title_key": "pro_plan",
                      "icon": "star",
                      "action": "accounts.bulk_update",
                      "payload": { "account_ids": "/local/selected_account_ids" },
                      "values": { "models": { "gpt-6-astra": { "ticket_plan": "pro" } } },
                      "condition": { "op": "nonempty", "path": "/local/selected_account_ids" },
                      "apply_result": "config",
                      "confirm": true,
                      "description": "Apply this explicit change to the selected accounts?",
                      "description_key": "bulk_confirm"
                    },
                    {
                      "type": "button",
                      "id": "bulk-astra-team",
                      "title": "Set Team",
                      "title_key": "team_plan",
                      "icon": "users",
                      "action": "accounts.bulk_update",
                      "payload": { "account_ids": "/local/selected_account_ids" },
                      "values": { "models": { "gpt-6-astra": { "ticket_plan": "team" } } },
                      "condition": { "op": "nonempty", "path": "/local/selected_account_ids" },
                      "apply_result": "config",
                      "confirm": true,
                      "description": "Apply this explicit change to the selected accounts?",
                      "description_key": "bulk_confirm"
                    }
                  ]
                },
                {
                  "type": "grid",
                  "id": "bulk-sol",
                  "title": "Sol",
                  "title_key": "sol",
                  "children": [
                    {
                      "type": "button",
                      "id": "bulk-sol-enable",
                      "title": "Enable",
                      "title_key": "enable",
                      "icon": "check",
                      "action": "accounts.bulk_update",
                      "payload": { "account_ids": "/local/selected_account_ids" },

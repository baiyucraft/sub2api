# 确保所有 SQL 迁移文件使用 LF 换行符
backend/migrations/*.sql text eol=lf

# Go 源代码文件
*.go text eol=lf

# 前端 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# Shell 脚本
*.sh text eol=lf

# 发布信任根以仓库字节参与 checksum，禁止 Git 自动换行转换
.agents/skills/sub2api-production-deploy/scripts/release/trust/*.pub -text

# 发布 helper 以原字节绑定 Git blob 和运行 checksum，跨平台保持 LF
.agents/skills/sub2api-production-deploy/scripts/**/*.py text eol=lf
.agents/skills/sub2api-production-deploy/scripts/**/README.md text eol=lf

# YAML/YML 配置文件
*.yaml text eol=lf
*.yml text eol=lf

# Dockerfile
Dockerfile text eol=lf

# 统计基准资产参与运行时 SHA-256 校验，跨平台 checkout 必须保持 LF
backend/internal/service/confidence_baselines/*.json text eol=lf
backend/internal/service/confidence_baselines/fixtures/*.json text eol=lf
